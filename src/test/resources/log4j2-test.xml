<?xml version="1.0" encoding="UTF-8"?>
<!-- Test logging: INFO, with Docker / HTTP wire logging kept quiet (the contract -->
<!-- tests would otherwise log every Docker API exchange at DEBUG).               -->
<Configuration status="WARN">
   <Appenders>
      <Console name="Console" target="SYSTEM_OUT">
         <PatternLayout pattern="%d{HH:mm:ss.SSS} | %-5level | %c{1} | %msg%n"/>
      </Console>
   </Appenders>
   <Loggers>
      <Logger name="org.testcontainers" level="WARN"/>
      <Logger name="com.github.dockerjava" level="WARN"/>
      <Logger name="tc" level="WARN"/>
      <Logger name="org.apache.http" level="WARN"/>
      <Logger name="com.kingsrook.qbits.authentik" level="INFO"/>
      <Root level="INFO">
         <AppenderRef ref="Console"/>
      </Root>
   </Loggers>
</Configuration>
